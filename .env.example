NODE_ENV=development
CORE_API_HOST=127.0.0.1
CORE_API_PORT=3000
DATABASE_URL=postgresql://obsidian_core:local_development_only@localhost:5432/obsidian_core
# Populate only after Auth0 tenant onboarding; never commit real values.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# Core-owned identity is the replacement path for new customer accounts. Keep Auth0 configured
# until all existing users have voluntarily reauthenticated and linked their accounts.
CORE_IDENTITY_ENABLED=false
CORE_IDENTITY_ISSUER=https://api.obsidian-systems.tech
CORE_IDENTITY_AUDIENCE=https://api.obsidian-systems.tech
# Generate with a cryptographically secure secret manager; use at least 32 random bytes encoded base64url.
CORE_IDENTITY_SIGNING_SECRET=
CORE_IDENTITY_ACCESS_TOKEN_TTL_SECONDS=900
CORE_IDENTITY_REFRESH_TOKEN_TTL_SECONDS=2592000
CORE_IDENTITY_SESSION_COOKIE_NAME=obsidian_core_session
# Customer portal pages that receive the emailed token as ?token=. These must be HTTPS in production.
CORE_IDENTITY_EMAIL_VERIFICATION_URL=https://portal.obsidian-systems.tech/verify-email
CORE_IDENTITY_PASSWORD_RESET_URL=https://portal.obsidian-systems.tech/reset-password
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_ID=
# Browser/API perimeter. Production requires HTTPS origins and both step-up values.
API_ALLOWED_ORIGINS=
API_SENSITIVE_RATE_LIMIT_MAX=60
API_SENSITIVE_RATE_LIMIT_WINDOW_MS=60000
AUTH0_STEP_UP_CLAIM=
AUTH0_STEP_UP_VALUE=
# Use only for a deliberate local or controlled bootstrap; never commit real values.
BOOTSTRAP_SUPER_ADMIN=false
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_AUTH0_SUBJECT=
# Payment provider selection. `commerce360` is an alias for the Access Worldpay configuration below.
# Keep disabled until the selected processor's full credentials and public webhook subscription are verified.
PAYMENTS_ENABLED=false
PAYMENT_PROCESSOR=square
# Stripe server-side integration. A Vercel application uses the matching publishable key directly
# with Stripe.js, but secret keys and webhook signing secrets stay in Core's managed secret store.
# `test` is the safe default. Core rejects `production` unless NODE_ENV=production.
STRIPE_ENVIRONMENT=test
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_DEVICE_CARE_PRICE_ID=
STRIPE_TEST_WEBHOOK_SIGNING_SECRET=
STRIPE_TEST_WEBHOOK_NOTIFICATION_URL=https://obsidian-core-2eat.onrender.com/v1/webhooks/stripe/test
STRIPE_PRODUCTION_SECRET_KEY=
STRIPE_PRODUCTION_PUBLISHABLE_KEY=
STRIPE_PRODUCTION_DEVICE_CARE_PRICE_ID=
STRIPE_PRODUCTION_WEBHOOK_SIGNING_SECRET=
STRIPE_PRODUCTION_WEBHOOK_NOTIFICATION_URL=https://obsidian-core-2eat.onrender.com/v1/webhooks/stripe/production
# Configure the URLs above as Stripe snapshot event destinations. Thin destinations require CORE-045
# and must not reuse this signing secret or state-changing Core route.
# Stripe signs with an event timestamp. Core rejects messages older than this (30-3600 seconds).
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# Square server-side integration; do not expose secrets to GUIs or commit actual values.
SQUARE_ENVIRONMENT=sandbox
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_APPLICATION_ID=
SQUARE_SANDBOX_LOCATION_ID=
# Square Catalog identifiers for the Core-owned Device Care enrollment workflow.
# The order template must be a customer-neutral, open $15.00 order containing the item variation.
SQUARE_SANDBOX_DEVICE_CARE_PLAN_VARIATION_ID=
SQUARE_SANDBOX_DEVICE_CARE_ORDER_TEMPLATE_ID=
SQUARE_SANDBOX_WEBHOOK_SIGNATURE_KEY=
# Temporary Render webhook URL; replace only after the custom domain is verified in Render and Square.
SQUARE_SANDBOX_WEBHOOK_NOTIFICATION_URL=https://obsidian-core-2eat.onrender.com/v1/webhooks/square/sandbox
SQUARE_PRODUCTION_ACCESS_TOKEN=
SQUARE_PRODUCTION_APPLICATION_ID=
SQUARE_PRODUCTION_LOCATION_ID=
SQUARE_PRODUCTION_DEVICE_CARE_PLAN_VARIATION_ID=
SQUARE_PRODUCTION_DEVICE_CARE_ORDER_TEMPLATE_ID=
SQUARE_PRODUCTION_WEBHOOK_SIGNATURE_KEY=
SQUARE_PRODUCTION_WEBHOOK_NOTIFICATION_URL=https://obsidian-core-2eat.onrender.com/v1/webhooks/square/production
SQUARE_API_VERSION=
# Commerce360/Access Worldpay server-side integration. Credentials are supplied by the Worldpay
# Implementation Manager and are used as Basic Auth by the future provider adapter.
WORLDPAY_ENVIRONMENT=try
WORLDPAY_BASE_URL=
WORLDPAY_USERNAME=
WORLDPAY_PASSWORD=
WORLDPAY_API_VERSION=
WORLDPAY_WEBHOOK_NOTIFICATION_URL=
# Retell AI server-only integration. Retell currently signs webhooks using its designated webhook API key.
RETELL_ENABLED=false
RETELL_API_KEY=
# Reserved for a vendor-provided distinct webhook secret; leave blank unless Retell issues one.
RETELL_WEBHOOK_SECRET=
# Customer transactional email through Resend. Keep disabled until the verified sender domain and API key
# are configured in the deployment environment. Sandbox receipts remain queued but are not sent by default.
CUSTOMER_EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=Obsidian Systems <receipts@updates.obsidian-systems.tech>
RESEND_REPLY_TO=
CUSTOMER_EMAIL_SEND_SANDBOX=false
CUSTOMER_EMAIL_DELIVERY_POLL_INTERVAL_MS=60000
# Twilio stays backend-only. Do not enable SMS until the Messaging Service, sender, opt-out
# configuration, and campaign registration are complete. Core defaults to no SMS without consent.
CUSTOMER_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_CALLBACK_URL=https://api.obsidian-systems.tech/v1/webhooks/twilio/status
TWILIO_INBOUND_WEBHOOK_URL=https://api.obsidian-systems.tech/v1/webhooks/twilio/inbound
STAFF_INVITATIONS_ENABLED=false
INVITATION_ACCEPT_URL=https://admin.obsidian-systems.tech/invitations/accept
AUTH0_INVITATION_EMAIL_CLAIM=email
