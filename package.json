{
  "name": "obsidian-core",
  "version": "0.1.0",
  "private": true,
  "description": "Backend services and shared domain packages for Obsidian Systems.",
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@obsidian/core-api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "db:up": "docker compose -f infra/local/docker-compose.yml up -d postgres",
    "db:down": "docker compose -f infra/local/docker-compose.yml down",
    "db:migrate": "npm run db:migrate --workspace=@obsidian/database",
    "db:seed": "npm run db:seed --workspace=@obsidian/database",
    "db:reset": "npm run db:reset --workspace=@obsidian/database",
    "db:validate": "npm run db:validate --workspace=@obsidian/database",
    "security:dependencies": "npm audit --omit=dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  }
}
